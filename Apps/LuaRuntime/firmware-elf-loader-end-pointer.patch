+     */
+    for (int i = 0; i < ELF_SECS; i++) {
+        if (elf->sec[i].addr && sym == elf->sec[i].v_addr + elf->sec[i].size) {
+            return elf->sec[i].addr + elf->sec[i].size;
+        }
+    }
 #else
