@@ -546,6 +546,20 @@ uintptr_t esp_elf_map_sym(esp_elf_t *elf, uintptr_t sym)
 #if CONFIG_ELF_LOADER_BUS_ADDRESS_MIRROR
     for (int i = 0; i < ELF_SECS; i++) {
         if (elf->sec[i].addr && sym >= elf->sec[i].v_addr &&
                 sym - elf->sec[i].v_addr < elf->sec[i].size) {
             return sym - elf->sec[i].v_addr + elf->sec[i].addr;
         }
     }
+    /*
+     * C++ emits a pointer to one-past-the-end for the end of a static array.
+     * Map that sentinel to the end of the loaded copy as well: returning 0 turns
